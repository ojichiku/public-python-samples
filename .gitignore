# --- Python build / cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.build/
build/
dist/
*.egg
*.egg-info/
.eggs/
.pip-wheel-metadata/
wheels/

# --- Virtual env (uv / venv) ---
.venv/
# uv が作る一時領域を使う場合
.uv/
# --- Environment files ---
.env
.env.*
!.env.example
# pyenv 等を使わないならコメントのまま
.python-version

# --- Packaging specs ---
# PyInstaller spec
*.spec
# Nuitka キャッシュ
.nuitka-cache/
# 一部ツールの汎用キャッシュ
.cache/

# --- Tools / Linters / Type checkers ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Editors / IDE ---
.vscode/
.idea/
*.code-workspace

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Logs / temp ---
*.log
!samples/logfilter-cli/tests/data/sample.log
*.tmp
*.bak

# --- Project specific (必要なら解除) ---
# /docs/_build/     # Sphinx等
# /examples/output/ # サンプル出力物
samples/password-generator-cli/release/PasswordGeneratorCLI
samples/password-generator-cli/release/*.zip
samples/password-generator-gui/release/PasswordGeneratorGUI
samples/password-generator-gui/release/*.zip

work/

# --- Runtime files for WordPress draft publisher sample ---
samples/wordpress-draft-publisher-codex/draft/*
!samples/wordpress-draft-publisher-codex/draft/.gitkeep
samples/wordpress-draft-publisher-codex/done/*
!samples/wordpress-draft-publisher-codex/done/.gitkeep
